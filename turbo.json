{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "CI",
    "TOGETHER_API_KEY",
    "TOGETHERLINK_DEBUG",
    "TOGETHERLINK_LIVE_CODEX_RESUME",
    "TOGETHERLINK_LIVE_MODELS_CHECK",
    "TOGETHERLINK_LIVE_PRIME_RLM",
    "TOGETHERLINK_LIVE_SMOKE",
    "TOGETHERLINK_LIVE_TEST_FILE",
    "VITEST_FILE_PARALLELISM",
    "VITEST_MAX_CONCURRENCY",
    "VITEST_RETRY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/tests/vitest.group.config.ts",
        "$TURBO_ROOT$/packages/tests/src/assert.ts",
        "$TURBO_ROOT$/packages/tests/src/codex-exec.ts",
        "$TURBO_ROOT$/packages/tests/src/command.ts",
        "$TURBO_ROOT$/packages/tests/src/context-limit.ts",
        "$TURBO_ROOT$/packages/tests/src/context.ts",
        "$TURBO_ROOT$/packages/tests/src/daemon-session.ts",
        "$TURBO_ROOT$/packages/tests/src/fixture-repo.ts",
        "$TURBO_ROOT$/packages/tests/src/json-lines.ts",
        "$TURBO_ROOT$/packages/tests/src/long-context.ts",
        "$TURBO_ROOT$/packages/tests/src/paths.ts",
        "$TURBO_ROOT$/packages/tests/src/types.ts",
        "$TURBO_ROOT$/packages/tests/src/harnesses/**"
      ],
      "outputs": []
    },
    "test:live": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
