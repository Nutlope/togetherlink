{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "chatgpt/**/*.ts",
    "claude/**/*.ts",
    "codex/**/*.ts",
    "core/**/*.ts",
    "daemon/**/*.ts",
    "deepseek/**/*.ts",
    "grok/**/*.ts",
    "hermes/**/*.ts",
    "opencode/**/*.ts",
    "pi/**/*.ts",
    "prime/**/*.ts",
    "vitest.config.ts",
    "vitest.group.config.ts",
    "vitest.live.config.ts"
  ]
}
