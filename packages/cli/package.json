{
  "name": "@togetherlink/cli",
  "version": "0.7.13",
  "description": "CLI for routing coding-agent harnesses through Together AI",
  "license": "MIT",
  "bin": {
    "togetherlink": "./dist/bin/togetherlink.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/bin/togetherlink.js', 0o755)\"",
    "dev": "pnpm build && sh -c 'node scripts/watch-bin-mode.mjs & tsc -p tsconfig.json --watch --preserveWatchOutput'",
    "watch": "pnpm dev",
    "typecheck": "pnpm --filter @togetherlink/models build && tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "test": "pnpm typecheck"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@togetherlink/models": "workspace:*",
    "undici": "^6.28.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
