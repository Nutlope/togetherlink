{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "node scripts/build-migration-surface.mjs migration-public",
  "outputDirectory": "migration-public",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/install.sh",
      "destination": "https://togetherlink.dev/install",
      "permanent": false
    },
    {
      "source": "/install",
      "destination": "https://togetherlink.dev/install",
      "permanent": false
    },
    {
      "source": "/togetherlink.js",
      "destination": "https://gateway.togetherlink.dev/legacy-migrate.js",
      "permanent": false
    },
    {
      "source": "/:path((?!latest\\.json$).*)",
      "destination": "https://togetherlink.dev/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/latest.json",
      "headers": [
        { "key": "content-type", "value": "application/json; charset=utf-8" },
        { "key": "cache-control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ]
}
